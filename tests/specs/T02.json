[
  {
    "name": "/start sends welcome + main menu",
    "steps": [
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Welcome! I am AGNTDEV Bot. Choose an option:",
              "reply_markup": {
                "inline_keyboard": [
                  [{ "text": "Status", "callback_data": "menu:status" }],
                  [{ "text": "Help", "callback_data": "menu:help" }]
                ]
              }
            }
          }
        ]
      }
    ]
  },
  {
    "name": "main menu: Status button replies OK",
    "steps": [
      {
        "send": { "callback": "menu:status" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "sendMessage", "payload": { "text": "OK" } }
        ]
      }
    ]
  },
  {
    "name": "main menu: Help button replies help text",
    "steps": [
      {
        "send": { "callback": "menu:help" },
        "expect": [
          { "method": "answerCallbackQuery" },
          {
            "method": "sendMessage",
            "payload": {
              "text": "Available commands:\n/start \u2014 Welcome message\n/status \u2014 Check bot status\n/help \u2014 Show this help"
            }
          }
        ]
      }
    ]
  }
]
