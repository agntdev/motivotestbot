[
  {
    "name": "/subscribe creates a subscriber record and confirms",
    "steps": [
      {
        "send": { "text": "/subscribe" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You have been subscribed successfully!" } }
        ]
      },
      {
        "send": { "text": "/subscribe" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You're already subscribed." } }
        ]
      }
    ]
  },
  {
    "name": "subscribe then unsubscribe — happy path",
    "steps": [
      {
        "send": { "text": "/subscribe" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You have been subscribed successfully!" } }
        ]
      },
      {
        "send": { "text": "/unsubscribe" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You have been unsubscribed." } }
        ]
      }
    ]
  },
  {
    "name": "/unsubscribe when not subscribed says not subscribed",
    "steps": [
      {
        "send": { "text": "/unsubscribe" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You are not subscribed." } }
        ]
      }
    ]
  },
  {
    "name": "/quote replies with exactly one quote",
    "steps": [
      {
        "send": { "text": "/quote" },
        "expect": [
          { "method": "sendMessage" }
        ]
      }
    ]
  }
]