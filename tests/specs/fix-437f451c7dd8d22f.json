[
  {
    "name": "/unsubscribe when not subscribed returns not-subscribed message",
    "steps": [
      {
        "send": { "text": "/unsubscribe" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You are not subscribed." } }
        ]
      }
    ]
  },
  {
    "name": "/unsubscribe scoped per-user — user 1 unsubscribing does not affect user 2",
    "steps": [
      {
        "send": { "text": "/unsubscribe", "chatId": 1, "userId": 1 },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You are not subscribed." } }
        ]
      },
      {
        "send": { "text": "/unsubscribe", "chatId": 1, "userId": 2 },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "You are not subscribed." } }
        ]
      }
    ]
  }
]